+# VAULT's library screen is the app's front end (C; its stb copies are compiled static).
+if(VAULT_DIR)
+	set(VAULT_SOURCES
+		${VAULT_DIR}/src/main.c ${VAULT_DIR}/src/ui.c ${VAULT_DIR}/src/gfx.c ${VAULT_DIR}/src/disc.c
