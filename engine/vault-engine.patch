+	target_sources(${TargetBin} PRIVATE ${VAULT_SOURCES})
+	set_source_files_properties(${VAULT_SOURCES} PROPERTIES
+		COMPILE_DEFINITIONS VAULT_EMBEDDED
+		INCLUDE_DIRECTORIES "${VAULT_DIR}/src;${VAULT_DIR}/third_party"
+		COMPILE_OPTIONS "-w;-O2")
+else()
+	message(FATAL_ERROR "VAULT_DIR must point at the VAULT (PSP4) repository")
+endif()
